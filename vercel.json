{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/es/experience",
      "destination": "/fr/experience",
      "permanent": true
    },
    {
      "source": "/es/cv",
      "destination": "/fr/cv",
      "permanent": true
    },
    {
      "source": "/es/politique-de-confidentialite",
      "destination": "/fr/politique-de-confidentialite",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/fr/about",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/fr/experience",
      "permanent": true
    },
    {
      "source": "/project",
      "destination": "/fr/project",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/fr/contact",
      "permanent": true
    },
    {
      "source": "/cv",
      "destination": "/fr/cv",
      "permanent": true
    },
    {
      "source": "/mentions-legales",
      "destination": "/fr/mentions-legales",
      "permanent": true
    },
    {
      "source": "/politique-de-confidentialite",
      "destination": "/fr/politique-de-confidentialite",
      "permanent": true
    },
    {
      "source": "/politique-des-cookies",
      "destination": "/fr/politique-des-cookies",
      "permanent": true
    },
    {
      "source": "/services/developpeur-react",
      "destination": "/fr/services/developpeur-react",
      "permanent": true
    },
    {
      "source": "/services/creation-site-internet-rennes",
      "destination": "/fr/services/creation-site-internet-rennes",
      "permanent": true
    },
    {
      "source": "/realisations/les-portes-de-montafilan",
      "destination": "/fr/realisations/les-portes-de-montafilan",
      "permanent": true
    },
    {
      "source": "/services/developpeur-django",
      "destination": "/fr/services/developpeur-django",
      "permanent": true
    },
    {
      "source": "/services/developpeur-flutter",
      "destination": "/fr/services/developpeur-flutter",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.googletagmanager.com/gtag/js https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com https://www.gstatic.com; font-src 'self' data:; connect-src 'self' blob: https://github-contributions-api.jogruber.de https://*.google-analytics.com https://www.googletagmanager.com https://www.google.com/recaptcha/; frame-src 'self' https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://www.youtube-nocookie.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "require-trusted-types-for 'script'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-fr.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-en.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/ai-catalog.json"
    },
    {
      "source": "/.well-known/ard.json",
      "destination": "/ai-catalog.json"
    }
  ]
}
