{
  "name": "portfolio",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run sitemap:generate",
    "build": "tsc -b && vite build && npm run seo:generate",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm run i18n:check",
    "preview": "vite preview",
    "i18n:check": "node scripts/sync-i18n.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs --write",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "seo:generate": "node scripts/seo-static.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@react-icons/all-files": "^4.1.0",
    "@tsparticles/engine": "^3.8.1",
    "@tsparticles/react": "^3.0.0",
    "bootstrap": "^5.3.5",
    "framer-motion": "^12.6.5",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.9",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-github-calendar": "^4.5.6",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.4.1",
    "react-intersection-observer": "^9.16.0",
    "react-parallax-tilt": "^1.7.300",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^7.5.0",
    "react-tooltip": "^5.28.1",
    "resend": "^4.3.0",
    "tsparticles": "^3.8.1",
    "typewriter-effect": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
